# Copia questo file in .env.local e riempi i due valori.
#
# Li trovi su Supabase: Project Settings → API.
#   VITE_SUPABASE_URL       → «Project URL»
#   VITE_SUPABASE_ANON_KEY  → la chiave «anon / public»
#
# .env.local non finisce su GitHub (lo esclude .gitignore), quindi chi
# scarica il progetto — o una sessione che gira nel cloud — parte senza.
# Senza questi due valori l'app si apre ma non riesce a parlare col database.
#
# La chiave «anon» non è un segreto: finisce dentro il codice dell'app e
# chiunque può leggerla dal browser. A proteggere i dati sono le regole di
# accesso del database (vedi SICUREZZA.md), non questa chiave.
# La chiave «service_role», invece, non va MAI messa qui né in nessun file
# del progetto: quella scavalca tutte le regole.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=incolla-qui-la-chiave-anon
